generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                   @id
  name               String?
  email              String                   @unique
  image              String?
  phone              String?
  role               Role                     @default(CUSTOMER)
  isLocked           Boolean                  @default(false)
  referralCode       String?                  @unique
  referredByCode     String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  addresses          Address[]
  customerTags       CustomerTag[]
  loyaltyPoints      LoyaltyPoint[]
  orders             Order[]
  referralLogs       ReferralLog[]            @relation("UserReferralLogs")
  reviewHelpfulVotes ReviewHelpfulVote[]
  reviews            Review[]
  storeCreditTxns    StoreCreditTransaction[]
  storeCredits       StoreCredit?
  wishlists          WishlistItem[]

  @@map("users")
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("Home")
  fullName  String
  phone     String
  division  String
  district  String
  area      String
  address   String
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@map("addresses")
}

model Category {
  id              String                   @id @default(cuid())
  name            String
  slug            String                   @unique
  description     String?
  image           String?
  parentId        String?
  isActive        Boolean                  @default(true)
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now())
  parent          Category?                @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]               @relation("CategoryTree")
  attributeConfig CategoryAttributeConfig?
  couponRules     CouponRule[]
  flashSales      FlashSale[]
  products        Product[]
  sizeGuide       SizeGuide?

  @@map("categories")
}

model CategoryAttributeConfig {
  id         String   @id @default(cuid())
  categoryId String   @unique
  attr1Label String   @default("Size")
  attr2Label String   @default("Color")
  attr1Hint  String?
  attr2Hint  String?
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_attribute_configs")
}

model Product {
  id                       String                     @id @default(cuid())
  name                     String
  slug                     String                     @unique
  description              String?
  price                    Decimal
  comparePrice             Decimal?
  categoryId               String
  brandId                  String?
  tags                     String?
  isActive                 Boolean                    @default(true)
  isFeatured               Boolean                    @default(false)
  isDigital                Boolean                    @default(false)
  downloadLimit            Int?
  downloadExpireHours      Int?
  minQty                   Int?
  maxQty                   Int?
  stepQty                  Int?
  weight                   Decimal?
  metaTitle                String?
  metaDescription          String?
  ogImage                  String?
  releaseAt                DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  ProductTags              ProductTags[]
  blogPosts                BlogPostProduct[]
  bundleItems              BundleItem[]
  digitalAssets            DigitalAsset[]
  dropNotifies             DropNotify[]
  episodes                 EpisodeProduct[]
  flashSales               FlashSale[]
  frequentlyBoughtTogether FrequentlyBoughtTogether[] @relation("FBTSource")
  fbtRelated               FrequentlyBoughtTogether[] @relation("FBTRelated")
  orderBumps               OrderBump[]
  orderItems               OrderItem[]
  priceRules               PriceRule[]
  addons                   ProductAddon[]
  images                   ProductImage[]
  variants                 ProductVariant[]
  brand                    Brand?                     @relation(fields: [brandId], references: [id])
  category                 Category                   @relation(fields: [categoryId], references: [id])
  reviewQAs                ReviewQA[]
  reviews                  Review[]
  subscriptionPlans        SubscriptionPlan[]
  wishlists                WishlistItem[]

  @@map("products")
}

model DropNotify {
  id        String   @id @default(cuid())
  productId String
  email     String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, email])
  @@map("drop_notifies")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  videoUrl  String?
  isVideo   Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  size               String
  color              String
  colorHex           String?
  sku                String              @unique
  stock              Int                 @default(0)
  price              Decimal?
  comparePrice       Decimal?
  costPrice          Decimal             @default(0)
  minQty             Int?
  maxQty             Int?
  cartItems          CartItem[]
  locationStock      LocationStock[]
  orderItems         OrderItem[]
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseOrderItems PurchaseOrderItem[]
  stockAlerts        StockAlert[]

  @@map("product_variants")
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String?    @unique
  userId    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Order {
  id                   String                @id @default(cuid())
  orderNumber          String                @unique
  userId               String?
  addressId            String?
  status               OrderStatus           @default(PENDING)
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus         @default(UNPAID)
  subtotal             Decimal
  discount             Decimal               @default(0)
  shippingCharge       Decimal               @default(0)
  total                Decimal
  couponId             String?
  note                 String?
  giftMessage          String?
  giftWrap             Boolean               @default(false)
  giftWrapCharge       Decimal               @default(0)
  deliveryDate         DateTime?
  depositAmount        Decimal               @default(0)
  customFields         Json?
  depositPaid          Boolean               @default(false)
  isGuest              Boolean               @default(false)
  guestEmail           String?
  codCallNote          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  shippingName         String
  shippingPhone        String
  shippingAddress      String
  shippingArea         String
  shippingDistrict     String
  shippingDivision     String
  tags                 String[]              @default([])
  affiliateConversions AffiliateConversion[]
  delivery             Delivery?
  items                OrderItem[]
  messages             OrderMessage[]
  shipments            OrderShipment[]
  statusLogs           OrderStatusLog[]
  address              Address?              @relation(fields: [addressId], references: [id])
  coupon               Coupon?               @relation(fields: [couponId], references: [id])
  user                 User?                 @relation(fields: [userId], references: [id])
  payment              Payment?
  returnRequests       ReturnRequest[]

  @@map("orders")
}

model OrderItem {
  id               String              @id @default(cuid())
  orderId          String
  productId        String
  variantId        String
  quantity         Int
  price            Decimal
  productName      String
  size             String
  color            String
  digitalDownloads DigitalDownload[]
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id])
  variant          ProductVariant      @relation(fields: [variantId], references: [id])
  shipmentItems    OrderShipmentItem[]
  returnItems      ReturnItem[]

  @@map("order_items")
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_logs")
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  status          PaymentStatus @default(UNPAID)
  amount          Decimal
  transactionId   String?
  gatewayResponse Json?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  order           Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Delivery {
  id            String         @id @default(cuid())
  orderId       String         @unique
  courier       CourierService
  consignmentId String?
  trackingCode  String?
  status        DeliveryStatus @default(PENDING)
  charge        Decimal        @default(0)
  estimatedDate DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  order         Order          @relation(fields: [orderId], references: [id])

  @@map("deliveries")
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Decimal
  minOrderAmount Decimal?
  maxUses        Int?
  usedCount      Int          @default(0)
  isActive       Boolean      @default(true)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  rule           CouponRule?
  orders         Order[]

  @@map("coupons")
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  poNumber   String              @unique
  supplierId String
  status     PurchaseOrderStatus @default(PENDING)
  totalCost  Decimal             @default(0)
  note       String?
  createdAt  DateTime            @default(now())
  receivedAt DateTime?
  items      PurchaseOrderItem[]
  supplier   Supplier            @relation(fields: [supplierId], references: [id])

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  purchaseOrderId String
  variantId       String
  quantity        Int
  costPrice       Decimal
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_order_items")
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Decimal
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  @@map("expenses")
}

model LoyaltyPoint {
  id          String           @id @default(cuid())
  userId      String
  points      Int
  type        LoyaltyPointType
  description String?
  orderId     String?
  createdAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("loyalty_points")
}

model ReferralLog {
  id           String   @id @default(cuid())
  referrerId   String
  refereeId    String
  orderId      String?
  creditAmount Int      @default(0)
  pointsAmount Int      @default(0)
  createdAt    DateTime @default(now())
  referrer     User     @relation("UserReferralLogs", fields: [referrerId], references: [id], onDelete: Cascade)

  @@map("referral_logs")
}

model Review {
  id           String              @id @default(cuid())
  userId       String
  productId    String
  rating       Int
  comment      String?
  isApproved   Boolean             @default(false)
  helpful      Int                 @default(0)
  createdAt    DateTime            @default(now())
  helpfulVotes ReviewHelpfulVote[]
  media        ReviewMedia[]
  product      Product             @relation(fields: [productId], references: [id])
  user         User                @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@map("reviews")
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_helpful_votes")
}

model AutoDiscount {
  id           String           @id @default(cuid())
  name         String
  ruleType     AutoDiscountRule
  thresholdQty Int?
  thresholdAmt Decimal?
  discountPct  Decimal
  isActive     Boolean          @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime         @default(now())

  @@map("auto_discounts")
}

model FlashSale {
  id            String         @id @default(cuid())
  name          String
  discountType  DiscountType
  discountValue Decimal
  scope         FlashSaleScope @default(SITEWIDE)
  productId     String?
  categoryId    String?
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("flash_sales")
}

model StockAlert {
  id        String         @id @default(cuid())
  email     String
  variantId String
  notified  Boolean        @default(false)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([email, variantId])
  @@map("stock_alerts")
}

model Banner {
  id        String   @id @default(cuid())
  title     String?
  image     String
  link      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("banners")
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model ShippingZone {
  id                String         @id @default(cuid())
  name              String
  districts         String
  charge            Decimal        @default(0)
  freeShippingAbove Decimal?
  isActive          Boolean        @default(true)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  rates             ShippingRate[]

  @@map("shipping_zones")
}

model Bundle {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  description  String?
  price        Decimal
  comparePrice Decimal?
  image        String?
  isActive     Boolean      @default(true)
  type         BundleType   @default(FIXED)
  minItems     Int?
  maxItems     Int?
  discountPct  Decimal?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        BundleItem[]

  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int     @default(1)
  sortOrder Int     @default(0)
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("bundle_items")
}

model DigitalAsset {
  id          String            @id @default(cuid())
  productId   String
  name        String
  storagePath String
  fileSize    Int?
  mimeType    String?
  sortOrder   Int               @default(0)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloads   DigitalDownload[]

  @@map("digital_assets")
}

model DigitalDownload {
  id            String       @id @default(cuid())
  assetId       String
  orderItemId   String
  userId        String?
  guestEmail    String?
  downloadCount Int          @default(0)
  maxDownloads  Int?
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  asset         DigitalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("digital_downloads")
}

model OrderShipment {
  id             String              @id @default(cuid())
  orderId        String
  shipmentNumber Int
  courier        CourierService
  consignmentId  String?
  trackingCode   String?
  status         DeliveryStatus      @default(PENDING)
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          OrderShipmentItem[]
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_shipments")
}

model OrderShipmentItem {
  id          String        @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  shipment    OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("order_shipment_items")
}

model ReturnRequest {
  id           String       @id @default(cuid())
  orderId      String
  userId       String?
  guestEmail   String?
  reason       ReturnReason
  note         String?
  photos       String[]
  status       ReturnStatus @default(PENDING)
  refundAmount Decimal?
  adminNote    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        ReturnItem[]
  order        Order        @relation(fields: [orderId], references: [id])

  @@map("return_requests")
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@map("return_items")
}

model AbandonedCart {
  id           String    @id @default(cuid())
  sessionId    String    @unique
  email        String?
  name         String?
  phone        String?
  items        Json
  subtotal     Decimal
  recoveredAt  DateTime?
  isRecovered  Boolean   @default(false)
  orderId      String?
  emailSent    Boolean   @default(false)
  emailSentAt  DateTime?
  email1SentAt DateTime?
  email2SentAt DateTime?
  email3SentAt DateTime?
  couponCode   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("abandoned_carts")
}

model Affiliate {
  id              String                @id @default(cuid())
  userId          String?
  name            String
  email           String                @unique
  code            String                @unique
  commissionType  DiscountType          @default(PERCENTAGE)
  commissionValue Decimal               @default(10)
  totalEarned     Decimal               @default(0)
  totalPaid       Decimal               @default(0)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  clicks          AffiliateClick[]
  conversions     AffiliateConversion[]

  @@map("affiliates")
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  ip          String?
  userAgent   String?
  landingPage String?
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_clicks")
}

model AffiliateConversion {
  id          String    @id @default(cuid())
  affiliateId String
  orderId     String
  orderTotal  Decimal
  commission  Decimal
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id])

  @@map("affiliate_conversions")
}

model CustomerTag {
  id     String @id @default(cuid())
  userId String
  tag    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@map("customer_tags")
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  posts     BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  excerpt     String?
  content     String
  coverImage  String?
  authorName  String            @default("Admin")
  categoryId  String?
  tags        String?
  isPublished Boolean           @default(false)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    BlogPostProduct[]
  category    BlogCategory?     @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

model BlogPostProduct {
  id        String   @id @default(cuid())
  postId    String
  productId String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([postId, productId])
  @@map("blog_post_products")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SizeGuide {
  id         String   @id @default(cuid())
  categoryId String   @unique
  unit       String   @default("cm")
  columns    Json
  rows       Json
  notes      String?
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("size_guides")
}

model Workflow {
  id          String          @id @default(cuid())
  name        String
  description String?
  trigger     WorkflowTrigger
  conditions  Json            @default("[]")
  actions     Json            @default("[]")
  isActive    Boolean         @default(true)
  runCount    Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        WorkflowRun[]

  @@map("workflows")
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  entityId   String
  entityType String
  status     String   @default("SUCCESS")
  log        String?
  createdAt  DateTime @default(now())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([entityId])
  @@map("workflow_runs")
}

model ShippingRate {
  id        String       @id @default(cuid())
  zoneId    String
  label     String
  minWeight Decimal?
  maxWeight Decimal?
  minQty    Int?
  maxQty    Int?
  rate      Decimal
  createdAt DateTime     @default(now())
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("shipping_rates")
}

model DeliverySchedule {
  id            String   @id @default(cuid())
  district      String?  @unique
  leadDays      Int      @default(2)
  cutoffHour    Int      @default(14)
  blackoutDates Json     @default("[]")
  workingDays   Json     @default("[1, 2, 3, 4, 5, 6]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("delivery_schedules")
}

model GiftCard {
  id             String                @id @default(cuid())
  code           String                @unique
  amount         Decimal
  balance        Decimal
  senderName     String?
  senderEmail    String?
  recipientEmail String
  message        String?
  isActive       Boolean               @default(true)
  expiresAt      DateTime?
  redeemedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  transactions   GiftCardTransaction[]

  @@map("gift_cards")
}

model GiftCardTransaction {
  id         String   @id @default(cuid())
  giftCardId String
  orderId    String?
  amount     Decimal
  type       String
  createdAt  DateTime @default(now())
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@map("gift_card_transactions")
}

model StoreCredit {
  id           String                   @id @default(cuid())
  userId       String                   @unique
  balance      Decimal                  @default(0)
