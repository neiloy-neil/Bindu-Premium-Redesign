  product_tags ProductTag @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ProductTags_AB_pkey")
  @@index([B], map: "_ProductTags_B_index")
  @@map("_ProductTags")
}

